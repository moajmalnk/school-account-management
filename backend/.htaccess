# School Admin Console API
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Block raw config from web if misconfigured
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
