# Production / preview builds call the Hostinger API directly.
VITE_API_BASE_URL=https://spi.macadz.com

# Local `npm run dev` uses the Vite proxy (same-origin /api).
# Default proxy target is https://spi.macadz.com — override when Hostinger is unreachable:
#   VITE_API_PROXY_TARGET=http://127.0.0.1:8090
# Then run `npm run setup:db` once and `npm run dev:local` (or `dev:api` + `dev` in two terminals).
# Local seed login: silverhills@tenant.com / school2026
# To force direct cross-origin calls from the browser instead:
# VITE_API_DIRECT=1

# Enable the PWA service worker during `vite dev` (off by default):
# VITE_PWA_DEV=1
