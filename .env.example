# Local and production frontends always call the Hostinger API.
VITE_API_BASE_URL=https://api.feezo.app

# Google Sign-In (OAuth Web client ID from Google Cloud Console).
# Required at build time for the Continue with Google button on /login.
VITE_GOOGLE_CLIENT_ID=

# Enable the PWA service worker during `vite dev` (off by default):
# VITE_PWA_DEV=1
